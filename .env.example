# Read by Node --env-file or your shell/platform; never commit real secrets.
PORT=8787
HOST=127.0.0.1
GAUGE_CLOUD=0
GAUGE_DATA_DIR=data
VAPID_SUBJECT=mailto:gauge@localhost
# Local PIN is optional; use a long random secret. Cloud requires >=8 characters.
# GAUGE_PIN=
# Cloud: GAUGE_CLOUD=1, HOST=0.0.0.0 and the actual HTTPS origin.
# GAUGE_ORIGIN=https://your-app.replit.app
# Set cloud secrets in the platform secret manager, not in this committed example.
