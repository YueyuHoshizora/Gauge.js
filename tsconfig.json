{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"], "types": ["node"], "strict": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "rootDir": ".", "outDir": "dist", "sourceMap": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["src/client", "scripts/generate-icons.ts"]
}
